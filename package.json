{
  "name": "cutilora-node",
  "version": "1.0.0",
  "private": true,
  "description": "Cutilora clinic platform API built with Node.js, Express, TypeScript and MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "nodemon dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:geo": "tsx src/modules/geo/seeds/geo.seed.ts",
    "migrate:tenant-subscriptions": "tsx src/modules/tenancy/scripts/migrate-legacy-tenant-subscriptions.ts",
    "test:e2e": "vitest run tests/e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
